# ============================================================================
# b00k5 Monorepo Environment Configuration
# ============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=b00k5_db
POSTGRES_USER=b00k5_admin
POSTGRES_PASSWORD=b00k5_secure_vault_password_2026
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://b00k5_admin:b00k5_secure_vault_password_2026@b00k5_postgres:5432/b00k5_db
SYNC_DATABASE_URL=postgresql://b00k5_admin:b00k5_secure_vault_password_2026@localhost:5432/b00k5_db

# Redis Message Broker & Cache
REDIS_PORT=6379
REDIS_URL=redis://b00k5_redis:6379/0

# MinIO Local S3 Storage
MINIO_ROOT_USER=minio_storage_admin
MINIO_ROOT_PASSWORD=minio_storage_secret_key_2026
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://b00k5_minio:9000

# 5 Isolated S3 Buckets for Indian Compliance & Financial Artifacts
MINIO_BUCKET_VAULT=b00k5-vault
MINIO_BUCKET_RECEIPTS=b00k5-receipts
MINIO_BUCKET_STATEMENTS=b00k5-statements
MINIO_BUCKET_SIGNED=b00k5-signed
MINIO_BUCKET_STATUTORY=b00k5-statutory

# Backend App Secret & JWT Auth
SECRET_KEY=change-this-to-a-secure-random-64-char-hex-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_ENV=development
DSC_MODE=simulated

# Hardware Token DSC Bridge (HYP 2003 / SoftHSM2 Mock)
DSC_BRIDGE_PORT=28045
DSC_BRIDGE_URL=http://b00k5_bridge_mock:28045
NEXT_PUBLIC_BRIDGE_URL=http://127.0.0.1:28045
B00K5_DEV_DSC_MOCK=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

